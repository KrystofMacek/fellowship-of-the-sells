# Copy to .env.local and fill in. Never commit .env.local.

# Etsy Open API v3 — from https://www.etsy.com/developers/your-apps
# ("Keystring" and "Shared secret" of your app)
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Claude API key — optional if you're logged in with `ant auth login`
# or ANTHROPIC_API_KEY is already set in your shell.
ANTHROPIC_API_KEY=
