# Copy to .env.local and fill in. Never commit .env.local.

# Etsy Open API v3 — this project's registered app ("Keystring" and "Shared secret")
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# Claude API key — optional if you're logged in with `ant auth login`
# or ANTHROPIC_API_KEY is already set in your shell.
ANTHROPIC_API_KEY=
